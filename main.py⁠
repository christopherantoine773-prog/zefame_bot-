import time
import requests

# Ton lien TikTok fourni
TIKTOK_LINK = "https://vt.tiktok.com/ZSqMtNsYH/"
TARGET_URL = "https://zefame.com/en/free-tiktok-views"

# En-têtes pour faire croire au site que la requête vient d'un vrai téléphone/navigateur
HEADERS = {
    "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1",
    "Referer": "https://zefame.com/en/free-tiktok-views",
    "Origin": "https://zefame.com",
}

def send_views():
    print("[*] Tentative d'envoi des vues pour le lien :", TIKTOK_LINK)
    try:
        # Note : Les sites de ce type utilisent souvent un formulaire POST en arrière-plan.
        # Ici, on simule l'envoi de la requête vers l'URL. 
        # (Si le site bloque les requêtes directes sans simulation de clic, il faudra ajuster l'URL d'API exacte).
        
        response = requests.post(TARGET_URL, headers=HEADERS, data={"url": TIKTOK_LINK}, timeout=30)
        
        if response.status_code == 200:
            print("[+] Action réussie ou requête acceptée par le serveur !")
        else:
            print(f"[-] Le serveur a répondu avec le code : {response.status_code}")
            
    except Exception as e:
        print(f"[-] Erreur de connexion : {e}")

def main():
    print("=== Démarrage du Bot Zefame (Version Mobile) ===")
    while True:
        send_views()
        
        # Attente de 30 minutes (30 minutes * 60 secondes = 1800 secondes)
        print("[*] En attente de 30 minutes avant la prochaine action...\n")
        time.sleep(1800)

if __name__ == "__main__":
    main()
